{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases {:cloverage {:extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
                       :extra-paths ["test"]
                       :main-opts ["-m" "cloverage.coverage"
                                   "-ns-regex" "us.chouser.open"
